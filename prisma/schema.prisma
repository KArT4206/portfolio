// Phase 1 of the portfolio CMS. Entities for Awards, Publications,
// Certifications, Experience, Education, Skills, Resume versions, and
// GitHub-presentation overrides are deliberately not modeled yet — they'll
// follow the same Project/ProjectAttachment/Media pattern established here
// once it's proven correct, rather than guessing their shape up front.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth ----------

model AdminUser {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  // True for a freshly-seeded account with a known temporary password —
  // the protected layout redirects everywhere else to /admin/change-password
  // until this is cleared, so the temporary credential can't linger in use.
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  lastLoginAt        DateTime? @db.Timestamptz(3)

  sessions   AdminSession[]
  auditLogs  AuditLog[]
  mediaFiles Media[]
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  // sha256 of the raw token — the raw token only ever lives in the httpOnly
  // cookie, never at rest, so a DB read never exposes anything replayable.
  tokenHash String    @unique
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

// Every login attempt (success or failure), used for brute-force lockout.
// Persisted rather than in-memory so the lockout survives serverless cold starts.
model LoginAttempt {
  id          String   @id @default(cuid())
  username    String
  ip          String
  success     Boolean
  attemptedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([username, attemptedAt])
  @@index([ip, attemptedAt])
}

// ---------- Media (shared file storage, used by any entity with attachments) ----------

model Media {
  id           String   @id @default(cuid())
  // Storage-provider key/path (local relative path, or Vercel Blob pathname) —
  // never exposed to the client directly; `url` is what gets rendered.
  key          String   @unique
  url          String
  originalName String
  mimeType     String
  size         Int
  sha256       String
  width        Int?
  height       Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  projectAttachments     ProjectAttachment[]
  projectCoverOf         Project[]               @relation("ProjectCoverImage")
  researchAttachments    ResearchAttachment[]
  awardCertificateOf     Award[]                 @relation("AwardCertificate")
  certificationCertOf    Certification[]         @relation("CertificationCertificate")
  publicationAttachments PublicationAttachment[]
  profileImageOf         Profile[]               @relation("ProfileImage")
  resumeOf               Resume[]

  @@index([sha256])
}

// ---------- Projects ----------

enum ProjectStatus {
  IN_DEVELOPMENT
  COMPLETED
  RESEARCH
  PAUSED
  ARCHIVED
}

enum ProjectCategory {
  SOFTWARE_ENGINEERING
  FULL_STACK
  AI_ML
  CYBERSECURITY
  EMBEDDED_SYSTEMS
  IOT
  RESEARCH
  HARDWARE
  OTHER
}

enum AttachmentVisibility {
  PUBLIC
  PRIVATE
}

model Project {
  id                  String            @id @default(cuid())
  slug                String            @unique
  title               String
  shortTitle          String? // compact heading for cards; falls back to title if unset
  shortDescription    String
  detailedDescription String?
  problem             String?
  solution            String[]
  // Array of { label: string, value: string } metric cards — kept as JSON
  // rather than a separate table since it's small, display-only, and always
  // rewritten as a whole set together (never queried/filtered individually).
  results             Json?
  role                String?
  technologies        String[]
  githubUrl           String?
  demoUrl             String?
  docsUrl             String?
  paperUrl            String?
  startDate           DateTime?         @db.Timestamptz(3)
  endDate             DateTime?         @db.Timestamptz(3)
  status              ProjectStatus     @default(IN_DEVELOPMENT)
  categories          ProjectCategory[]
  featured            Boolean           @default(false)
  published           Boolean           @default(false)
  displayOrder        Int               @default(0)

  coverImageId String?
  coverImage   Media?  @relation("ProjectCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)

  attachments ProjectAttachment[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3) // soft delete — see repoConfig-style "never hard-delete without confirmation"

  @@index([published, deletedAt, displayOrder])
  @@index([featured])
}

model ProjectAttachment {
  id           String               @id @default(cuid())
  projectId    String
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId      String
  media        Media                @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  label        String // e.g. "IEEE Paper", "Project Report"
  description  String?
  visibility   AttachmentVisibility @default(PUBLIC)
  displayOrder Int                  @default(0)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)

  @@index([projectId, displayOrder])
}

// ---------- Research ----------

enum ResearchStatus {
  DRAFT
  IN_REVIEW
  PRESENTED
  PUBLISHED
}

model Research {
  id           String         @id @default(cuid())
  title        String
  description  String?
  authors      String[]
  conference   String?
  status       ResearchStatus @default(PUBLISHED)
  year         Int?
  doi          String?
  paperUrl     String?
  // Array of { label: string, value: string } instrument readouts — same
  // small, display-only, always-rewritten-as-a-whole-set shape as
  // Project.results, so it gets the same JSON-not-a-table treatment.
  metrics      Json?
  featured     Boolean        @default(false)
  published    Boolean        @default(false)
  displayOrder Int            @default(0)

  attachments ResearchAttachment[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([published, deletedAt, displayOrder])
  @@index([featured])
}

model ResearchAttachment {
  id           String               @id @default(cuid())
  researchId   String
  research     Research             @relation(fields: [researchId], references: [id], onDelete: Cascade)
  mediaId      String
  media        Media                @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  label        String
  description  String?
  visibility   AttachmentVisibility @default(PUBLIC)
  displayOrder Int                  @default(0)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)

  @@index([researchId, displayOrder])
}

// ---------- Publications ----------

enum PublicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  PUBLISHED
}

model Publication {
  id              String            @id @default(cuid())
  title           String
  authors         String[]
  journal         String?
  publicationDate DateTime?         @db.Timestamptz(3)
  doi             String?
  url             String?
  status          PublicationStatus @default(DRAFT)
  abstract        String?
  keywords        String[]
  featured        Boolean           @default(false)
  published       Boolean           @default(false)
  displayOrder    Int               @default(0)

  attachments PublicationAttachment[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([published, deletedAt, displayOrder])
  @@index([featured])
}

model PublicationAttachment {
  id            String               @id @default(cuid())
  publicationId String
  publication   Publication          @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  mediaId       String
  media         Media                @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  label         String
  description   String?
  visibility    AttachmentVisibility @default(PUBLIC)
  displayOrder  Int                  @default(0)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)

  @@index([publicationId, displayOrder])
}

// ---------- Awards ----------

model Award {
  id           String  @id @default(cuid())
  title        String
  organization String?
  detail       String?
  year         Int?

  // Either an uploaded certificate file, an external certificate URL, or
  // neither — the public site only ever shows a "[ VIEW CERTIFICATE ]"
  // action when one of these is actually set, never as a placeholder.
  certificateMediaId String?
  certificateMedia   Media?  @relation("AwardCertificate", fields: [certificateMediaId], references: [id], onDelete: SetNull)
  certificateUrl     String?

  featured     Boolean @default(false)
  published    Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([published, deletedAt, displayOrder])
}

// ---------- Certifications ----------

model Certification {
  id            String    @id @default(cuid())
  name          String
  issuer        String
  credentialId  String?
  credentialUrl String?
  description   String?
  issueDate     DateTime? @db.Timestamptz(3)
  expiresDate   DateTime? @db.Timestamptz(3) // null = does not expire

  // Same file-or-link pattern as Award.certificate* — the public site only
  // ever shows a certificate action once one of these is actually set.
  certificateMediaId String?
  certificateMedia   Media?  @relation("CertificationCertificate", fields: [certificateMediaId], references: [id], onDelete: SetNull)

  published    Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([published, deletedAt, displayOrder])
}

// ---------- Experience ----------

model Experience {
  id        String    @id @default(cuid())
  org       String
  role      String
  location  String?
  startDate DateTime? @db.Timestamptz(3)
  endDate   DateTime? @db.Timestamptz(3) // null = present
  bullets   String[]

  published    Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([published, deletedAt, displayOrder])
}

// ---------- Education ----------

model Education {
  id         String    @id @default(cuid())
  school     String
  degree     String
  location   String?
  startDate  DateTime? @db.Timestamptz(3)
  endDate    DateTime? @db.Timestamptz(3) // null = ongoing / expected
  coursework String[]

  published    Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([published, deletedAt, displayOrder])
}

// ---------- Skills ----------

model SkillGroup {
  id       String   @id @default(cuid())
  category String
  items    String[]

  published    Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([published, deletedAt, displayOrder])
}

// ---------- Site Settings ----------

// Singleton row (always id "singleton") — feature flags for the optional
// fun/easter-egg layer, editable from Admin -> Site Settings so any of it
// can be switched off without a code change.
model SiteSetting {
  id                       String   @id @default("singleton")
  funModeEnabled           Boolean  @default(true)
  matrixInteractionEnabled Boolean  @default(true)
  ghostEnabled             Boolean  @default(true)
  arcadeEnabled            Boolean  @default(true)
  robotEnabled             Boolean  @default(true)
  explorerEnabled          Boolean  @default(true)
  terminalEnabled          Boolean  @default(true)
  idleEventsEnabled        Boolean  @default(true)
  soundDefaultOn           Boolean  @default(false)
  maxWarpEnabled           Boolean  @default(true)
  updatedAt                DateTime @updatedAt @db.Timestamptz(3)
}

// ---------- Resume ----------

model Resume {
  id          String  @id @default(cuid())
  // Either an uploaded file or an external URL — the same file-or-link
  // pattern used by Award/Certification certificates.
  mediaId     String?
  media       Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  externalUrl String?
  label       String? // e.g. "Resume — Aug 2026"
  // Only one Resume should be active at a time; enforced in the save
  // action (unset any other active row), not at the schema level, since
  // Postgres has no simple "at most one true" constraint.
  isActive    Boolean @default(false)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([isActive, deletedAt])
}

// ---------- Contact ----------

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt DateTime             @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
}

// ---------- Audit ----------

enum AuditResult {
  SUCCESS
  FAILURE
}

model AuditLog {
  id           String      @id @default(cuid())
  action       String // e.g. "project.created", "auth.login"
  actorId      String?
  actor        AdminUser?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  resourceType String?
  resourceId   String?
  metadata     Json?
  ip           String?
  result       AuditResult @default(SUCCESS)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([actorId])
}

// ---------- Profile ----------

// Singleton row (id="singleton") — the admin-editable version of the
// hand-authored `profile` object in src/lib/data.ts.
model Profile {
  id          String   @id @default("singleton")
  name        String
  initials    String
  tagline     String
  location    String
  email       String
  githubUrl   String
  linkedinUrl String
  summary     String
  heroLines   String[]

  profileImageId String?
  profileImage   Media?  @relation("ProfileImage", fields: [profileImageId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// ---------- GitHub presentation ----------

// Admin-editable presentation metadata for a live GitHub repo, keyed by the
// repo's exact `name` (case-sensitive) — mirrors src/lib/repoConfig.ts,
// which this replaces as the live source. GitHub itself remains the source
// of truth for the repo's actual data (stars, description, language, ...);
// rows here only ever change how that data is labeled/ordered/filtered.
// Created on demand (only repos an admin has actually customized get a
// row) rather than one row per repo up front.
model GithubRepoOverride {
  id            String   @id @default(cuid())
  repoName      String   @unique
  alias         String?
  categories    String[]
  featured      Boolean  @default(false)
  hidden        Boolean  @default(false)
  displayOrder  Int?
  caseStudySlug String?
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
}
