# Both optional — the GitHub project feed works with neither set.

# Raises the GitHub API rate limit from 60/hr to 5000/hr (unauthenticated
# is plenty given the 1-hour server-side cache, but set this if you add many
# featured repos with README excerpts, or need private-repo access).
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# Enables instant cache revalidation via GitHub webhooks instead of waiting
# up to 1 hour. Set the same value in your repo's webhook config
# (Settings → Webhooks → Secret). See src/app/api/github/webhook/route.ts.
GITHUB_WEBHOOK_SECRET=
