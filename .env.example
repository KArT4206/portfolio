# Both optional — the GitHub project feed works with neither set.

# Raises the GitHub API rate limit from 60/hr to 5000/hr (unauthenticated
# is plenty given the 1-hour server-side cache, but set this if you add many
# featured repos with README excerpts, or need private-repo access).
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# Enables instant cache revalidation via GitHub webhooks instead of waiting
# up to 1 hour. Set the same value in your repo's webhook config
# (Settings → Webhooks → Secret). See src/app/api/github/webhook/route.ts.
GITHUB_WEBHOOK_SECRET=

# ---- Admin CMS (required) ----

# Postgres connection string. Local dev: see README for the `createdb` steps.
# Production: Vercel dashboard → your project → Storage → Create → Postgres
# (auto-injects this).
DATABASE_URL=

# Signs admin session cookies (HMAC-SHA256). Generate with: openssl rand -hex 32
# Rotating this instantly invalidates every existing admin session.
ADMIN_SESSION_SECRET=

# "local" (default) writes uploads to ./storage/uploads on disk — fine for a
# single-instance dev server, wrong for Vercel's ephemeral filesystem.
# "vercel-blob" uses BLOB_READ_WRITE_TOKEN below. Set to "vercel-blob" in
# production.
STORAGE_PROVIDER=local

# Only needed when STORAGE_PROVIDER=vercel-blob. Vercel dashboard → your
# project → Storage → Create → Blob (auto-injects this).
BLOB_READ_WRITE_TOKEN=
